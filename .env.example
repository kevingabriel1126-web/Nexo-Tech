# Copiá este archivo como ".env" y completá los datos. No subas el .env al repositorio.
PORT=3000

# SQL Server
DB_SERVER=localhost
# DB_PORT=1433            # dejalo comentado si usás una instancia con nombre (ej: DB_SERVER=localhost\SQLEXPRESS)
DB_NAME=EcommerceBanfield
DB_USER=banfield_app
DB_PASSWORD=CambiarEstaClave_123!
DB_ENCRYPT=false          # true si el servidor lo exige (Azure SQL siempre)
DB_TRUST_CERT=true        # true para certificados autofirmados (desarrollo)

# Firma de las sesiones. Poné un texto largo y aleatorio (mínimo 16 caracteres).
TOKEN_SECRET=cambiame-por-un-texto-largo-y-aleatorio
# NODE_ENV=production
